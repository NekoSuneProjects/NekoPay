PORT=3000
APP_BASE_URL=https://pay.nekolive.co.uk
APP_URL=https://pay.nekolive.co.uk
PUBLIC_URL=https://pay.nekolive.co.uk
PLATFORM_NAME=NekoPay
STORE_TAX_RATE=0.20
APP_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@nekopay.local
ADMIN_PASSWORD=ChangeMe123!
DB_DIALECT=sqlite
DB_STORAGE=./data/nekopay.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nekopay
DB_USER=root
DB_PASSWORD=
CRYPTO_PAYMENT_MIN_CONFIRMATIONS=25
CRYPTO_PAYMENT_TIMEOUT_MINUTES=20
PAYMENT_WORKER_INTERVAL_MS=15000
CHAIN_RATE_LIMIT_COOLDOWN_MS=120000
NEKOPAY_CHAIN_TIMEOUT_MS=12000
ZBD_API_KEY=

# RPC / Blockbook backend manager
NEKOPAY_BACKENDS_FILE=
NEKOPAY_BACKEND_COOLDOWN_MS=300000
NEKOPAY_BACKEND_PROBE_LIMIT=8
NEKOPAY_BLOCKBOOK_MIN_INTERVAL_MS=250
NEKOPAY_BLOCKBOOK_MAX_RETRIES=3
NEKOPAY_BLOCKBOOK_TIMEOUT_MS=20000
NEKOPAY_EVMRPC_MIN_INTERVAL_MS=150
NEKOPAY_EVMRPC_MAX_RETRIES=3
NEKOPAY_EVMRPC_TIMEOUT_MS=20000
NEKOPAY_EXPLORER_MIN_INTERVAL_MS=350
NEKOPAY_EXPLORER_MAX_RETRIES=2
NEKOPAY_EXPLORER_TIMEOUT_MS=20000
NEKOPAY_EVM_SCAN_MAX_BLOCKS=5000
NEKOPAY_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional per-chain comma-separated overrides. Put self-hosted endpoints first.
NEKOPAY_BTC_BACKEND_URLS=
NEKOPAY_LTC_BACKEND_URLS=
NEKOPAY_DOGE_BACKEND_URLS=
NEKOPAY_ETH_BACKEND_URLS=
NEKOPAY_BSC_BACKEND_URLS=
NEKOPAY_POL_BACKEND_URLS=
NEKOPAY_BASE_BACKEND_URLS=

# NekoLive Creator Payment mode.
# Use the same long random value in NekoLive's NEKOPAY_SERVICE_API_KEY.
NEKOLIVE_SERVICE_API_KEY=replace-with-a-long-random-service-secret
# Optional separate signing key for the 15-minute creator-link state.
NEKOLIVE_LINK_SIGNING_SECRET=
# Optional dedicated NekoLive creator callback secret. If left blank, NekoPay
# uses NEKOLIVE_SERVICE_API_KEY for creator checkout.completed callbacks.
# If you set NekoLive NEKOPAY_WEBHOOK_SECRET, set this to the SAME value.
NEKOLIVE_WEBHOOK_SECRET=
# Server-to-server callback retry/recovery settings. Applies to all NekoLive
# creator payment methods, including direct-chain crypto.
MERCHANT_WEBHOOK_ATTEMPTS=4
MERCHANT_WEBHOOK_RETRY_BASE_MS=1000
NEKOLIVE_WEBHOOK_RECOVERY_INTERVAL_MS=60000

# Optional SMTP for verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
